# Jamf Platform API
JAMF_BASE_URL=https://us.api.jamfcloud.com
JAMF_CLIENT_ID=YOUR_CLIENT_ID
JAMF_CLIENT_SECRET=YOUR_CLIENT_SECRET
JAMF_ENVIRONMENT_ID=YOUR_ENVIRONMENT_ID
JAMF_PAGE_SIZE=500

# InfluxDB
INFLUX_URL=http://YOUR_INFLUX_SERVER:8086
INFLUX_ORG=NFVCSD
INFLUX_BUCKET=jamf_inventory
INFLUX_TOKEN=YOUR_INFLUX_WRITE_TOKEN

# Local state - only stores OS version names, never devices
STATE_FILE=/var/lib/jamf-influx/known_versions.json