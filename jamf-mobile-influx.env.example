# Copy to /etc/jamf-mobile-influx.env and edit there. Never commit real credentials.
JAMF_BASE_URL=https://us.api.jamfcloud.com
JAMF_CLIENT_ID=REPLACE_ME
JAMF_CLIENT_SECRET=REPLACE_ME
JAMF_ENVIRONMENT_ID=REPLACE_ME
JAMF_PAGE_SIZE=500
INFLUX_URL=https://influx.example.com
INFLUX_ORG=REPLACE_ME
INFLUX_BUCKET=jamf_inventory
INFLUX_TOKEN=REPLACE_ME
STATE_FILE=/var/lib/jamf-mobile-influx/known_versions.json
